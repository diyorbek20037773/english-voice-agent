{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "server/src",
    "shared",
    "scripts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "mock-openai",
    "web/src/voice/transcript-store.ts",
    "web/src/voice/vad.ts",
    "web/src/voice/turns.ts",
    "web/src/voice/question.ts",
    "web/src/lib/markdown.ts",
    ".railway",
    "web/src/voice/transcriber.ts",
    "web/src/lib/image.ts"
  ]
}
