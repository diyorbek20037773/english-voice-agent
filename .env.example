# Local development environment. Create the real .env with:
#   pnpm setup:secrets --openai-key-file <file containing your OpenAI key>
# .env is gitignored. Never put the OpenAI key in frontend code or VITE_* variables.

NODE_ENV=development
HOST=::
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# Origin the browser uses. Dev (Vite): http://localhost:5173 · production build: http://localhost:3000
# Railway: not needed — defaults to https://$RAILWAY_PUBLIC_DOMAIN (provided by Railway)
ALLOWED_ORIGIN=http://localhost:5173

# Access: OPEN_ACCESS=true shows no unlock screen (anyone with the URL can use the app).
# Otherwise APP_ACCESS_TOKEN unlocks a device (generated, 30 characters).
# OPEN_ACCESS=true
APP_ACCESS_TOKEN=generated

# OpenAI — permanent key stays on the backend only
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_TRANSCRIPTION_MODEL=gpt-live-transcribe
OPENAI_ANSWER_MODEL=gpt-6-luna
# Detailed mode model (empty = same as OPENAI_ANSWER_MODEL; gpt-6.1-sol costs ~20x more)
OPENAI_ANSWER_MODEL_DETAILED=
OPENAI_QUICK_REASONING=none
OPENAI_DETAILED_REASONING=low
# Not used by transcription-only sessions (kept for the env contract)
OPENAI_REALTIME_MODEL=

# Optional
# CANDIDATE_PROFILE="Your approved background facts, used only for personal questions"
# TRANSCRIPTION_KEYWORDS=TypeScript,PostgreSQL,Kubernetes
# ANSWER_DAILY_LIMIT=200
# ANSWER_RATE_PER_MINUTE=20
# VOICE_SESSIONS_PER_HOUR=30
# VOICE_TOKEN_TTL_SECONDS=60
